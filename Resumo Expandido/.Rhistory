library(tidyverse)
library(forecast)
library(lubridate)
# Carregando os dados
base = read.csv('dengue.csv')
# Preparando os dados
base$Mês.Notificação = as.factor(base$Período)
base1 = base[c(1:204),]
novo = base[c(205:215),]
base_ts = ts(base1$Casos.Prováveis, frequency=12, start=c(2007,1))
# Visualização gráfica
plot(base_ts, type = "s", ylab = "Casos Prováveis", xlab = "Ano")
# Ajustando o eixo Y com valores legíveis
axis(2, at = pretty(base_ts), labels = format(pretty(base_ts), big.mark = ".", scientific = FALSE))
# Aplicando o modelo SES (Suavização Exponencial Simples)
SES = ses(base_ts)
# Visualizando o ajuste do modelo SES
plot(SES, main = "Modelo SES - Casos Prováveis", ylab = "Casos Prováveis", xlab = "Ano")
axis(2, at = pretty(SES$fitted), labels = format(pretty(SES$fitted), big.mark = ".", scientific = FALSE))
library(tidyverse)
library(forecast)
library(lubridate)
# Carregando os dados
base = read.csv('dengue.csv')
# Preparando os dados
base$Mês.Notificação = as.factor(base$Período)
base1 = base[c(1:204),]
novo = base[c(205:215),]
base_ts = ts(base1$Casos.Prováveis, frequency=12, start=c(2007,1))
# Visualização gráfica com ajuste do eixo Y
plot(base_ts, type = "s", axes = FALSE, ylab = "Casos Prováveis", xlab = "Ano", main = "Série Temporal - Casos de Dengue")
# Adicionando os eixos manualmente
axis(1, at = seq(2007, 2025, by = 2)) # Eixo X com intervalos bienais
axis(2, at = pretty(base_ts), labels = format(pretty(base_ts), big.mark = ".", scientific = FALSE)) # Eixo Y ajustado
box() # Para desenhar a borda do gráfico
# Aplicando o modelo SES (Suavização Exponencial Simples)
SES = ses(base_ts)
# Visualização do modelo SES com eixo ajustado
plot(SES, main = "Modelo SES - Casos de Dengue", ylab = "Casos Prováveis", xlab = "Ano", axes = FALSE)
axis(1, at = seq(2007, 2025, by = 2)) # Eixo X para o modelo
axis(2, at = pretty(SES$fitted), labels = format(pretty(SES$fitted), big.mark = ".", scientific = FALSE)) # Eixo Y para o modelo
box()
